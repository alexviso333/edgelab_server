# Copia este fichero a .env y rellena lo que quieras usar. Todo es opcional salvo la contraseña.
EDGELAB_PASSWORD=pon-una-contraseña-larga
EDGELAB_BANKROLL=1000
EDGELAB_KELLY=0.25
EDGELAB_MAX_STAKE_PCT=0.03

# Telegram (gratis): habla con @BotFather -> /newbot -> token; tu chat id con @userinfobot
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Statshub: si Cloudflare bloquea la IP de la VM, prueba primero a subir el intervalo;
# si sigue, despliega deploy/statshub-relay.js en Cloudflare Workers (gratis) y pon su URL aquí.
STATSHUB_MIN_INTERVAL=2.5
STATSHUB_RELAY=
STATSHUB_COOKIE=
RELAY_KEY=

# Sofascore para rojas/xG en vivo (1 = intentar; se desactiva solo si bloquea)
SOFASCORE_ENABLED=1

# Margen supuesto de bet365 en directo para los backtests con precio simulado
EDGELAB_INPLAY_MARGIN=0.07

# Competiciones (claves): EPL,LALIGA,SERIEA,BUNDES,LIGUE1,UCL,UEL,UECL,CDR
EDGELAB_COMPETITIONS=EPL,LALIGA,SERIEA,BUNDES,LIGUE1,UCL,UEL,UECL,CDR

# IA opcional para redactar el informe de cada partido: gemini (nivel gratuito) o anthropic
LLM_PROVIDER=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
